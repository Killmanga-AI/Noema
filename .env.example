# Copy to .env and change the password before running docker compose.
# Avoid the characters ; and = in the password, it is placed in a connection string.
POSTGRES_DB=noema
POSTGRES_USER=noema
POSTGRES_PASSWORD=change-me-before-use

# Signing key for login tokens. Generate your own: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-the-output-of-openssl-rand-base64-48

# Creates the first administrator when there are no users yet. Remove the password after the first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-passphrase
